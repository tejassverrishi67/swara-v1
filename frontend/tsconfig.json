{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@swara/shared": ["../shared/types.ts"],
      "@swara/shared/*": ["../shared/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
