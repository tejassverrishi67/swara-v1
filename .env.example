# TEMPLATE — no real secrets in this file. It is meant to be committed.
#
# Copy this file to `swara/.env` (git-ignored) and put your real keys THERE.
# The backend loads `swara/.env` automatically at startup (see backend/load-env.ts).
# The frontend never reads any of these — the whole point of the /tts proxy is
# that provider keys stay server-side.
#
# Step-by-step key placement instructions: see ../API_ins.txt

# --- Backend HTTP server ---
PORT=8787

# --- LLM (interpretation + expression generation) ---
# Provider is intentionally NOT fixed yet (see SWARA_KNOWLEDGE.md §13 and SPEC.md §3c).
# Leave LLM_PROVIDER and LLM_API_KEY blank to use the deterministic mock client.
# LLM_PROVIDER: "openai" | "anthropic" | any OpenAI-compatible provider (e.g. "groq").
LLM_PROVIDER=
LLM_API_KEY=
# Optional model id override. Defaults: openai -> gpt-4o-mini, anthropic -> claude-3-5-sonnet-20241022.
LLM_MODEL=
# Required for any OpenAI-COMPATIBLE provider that is not OpenAI itself
# (Groq, OpenRouter, Azure, a local server, ...). Ignored when LLM_PROVIDER=anthropic.
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# --- Sarvam Bulbul TTS ---
# Leave SARVAM_API_KEY blank to use mock (silent) audio.
SARVAM_API_KEY=
# Model id. Accepts "v2" | "v3" | "v3-beta" (a "bulbul:" prefix is added if missing),
# or a full id like "bulbul:v2". Decision pending, see SPEC.md §3d.
#
# IMPORTANT: speaker and model are coupled. Sarvam rejects a v2 speaker on v3 and
# vice-versa. The picker exposes two voices per model version (see
# swara/backend/lib/voices.ts). The frontend's default speaker is set in
# swara/frontend/src/App.tsx (currently "priya", a bulbul:v3 speaker). If you
# switch this to bulbul:v2, change that default to a v2 speaker ("anushka" or
# "abhilash").
SARVAM_MODEL=v2

# --- Provenance store (storage-agnostic; see backend/lib/provenance.ts) ---
# "memory" | "file". Defaults to "file": provenance exists to reconstruct what
# happened after the fact, and "memory" discards it on every restart (F-06).
PROVENANCE_BACKEND=file
# Used only when PROVENANCE_BACKEND=file. JSON Lines, one record per line.
PROVENANCE_FILE_PATH=./data/provenance.jsonl
# Records older than this many days are pruned (on write + on demand). These
# records carry medical-symptom content; 90 days is the documented default
# (SPEC.md §9). 0 disables pruning.
PROVENANCE_RETENTION_DAYS=90
# "true" stores concept ids + structure but NOT the spoken text or the
# interpretation/expression strings — accountability trail without the transcript.
PROVENANCE_REDACT=

# --- Identity / multi-user (Features.md F-05) ---
# Set a strong random secret to enable per-device sessions (signed http-only
# cookie). Leave BLANK for single-user local mode — in which case the server
# REFUSES to bind to a non-loopback HOST, because one shared Trust Ladder means
# one user's pin can make another user's device speak with no Meaning Check.
SESSION_SECRET=
SESSION_COOKIE_NAME=swara_device
SESSION_TTL_DAYS=365

# --- Deployment hardening (Features.md F-22) ---
# Interface to bind. Defaults to loopback. A non-loopback value needs SESSION_SECRET.
HOST=127.0.0.1
# Comma-separated allowed CORS origins. Empty ⇒ localhost dev only. "*" is
# accepted but logged as unsafe — do not deploy like that.
CORS_ORIGINS=
# Per-IP (and per-user) budget for the money-spending endpoints.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# --- Frontend (Vite) ---
# Only VITE_-prefixed vars are exposed to the browser bundle, and none of them
# are secrets.
VITE_API_BASE=http://localhost:8787
